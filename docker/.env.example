# Docker environment variables for the ytdownloader project
PROJECT_NAME=ytdownloader
NGINX_PORT=80

# Public HTTPS hostname terminated by Caddy (ADR-0007).
# In production it comes from the APP_DOMAIN GitHub secret; set it in docker/.env
# when running the prod compose file by hand.
APP_DOMAIN=change_me_please.tld

# Xdebug
XDEBUG_INSTALL=false  # true to install Xdebug, false to skip installation
XDEBUG_MODE=off  # off in production, debug for development
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# Database configuration
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5427
DB_DATABASE=ytdownloader
DB_USERNAME=user
DB_PASSWORD=123456

# Redis configuration
REDIS_PASSWORD=123456
REDIS_PORT=6380
