{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.source.edit_title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="page-title">{{ 'ui.source.edit_heading'|trans }}</h1>
            <p class="page-subtitle">{{ 'ui.source.edit_hint'|trans }}</p>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path('ui_source_index') }}">{{ 'ui.source.back_to_list'|trans }}</a>
    </div>

    <div class="app-card p-4 p-lg-5">
        {{ include('ui/source/_form.html.twig', {'button_label': 'ui.source.update'|trans}) }}
    </div>
{% endblock %}
