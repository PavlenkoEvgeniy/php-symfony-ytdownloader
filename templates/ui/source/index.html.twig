{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.source.index_title'|trans }}{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success mt-1" role="alert">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger mt-1" role="alert">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning mt-1" role="alert">
            {{ message }}
        </div>
    {% endfor %}
    <div class="d-flex justify-content-between mt-4 mb-2">
        <a class="btn btn-outline-success" href="{{ path('ui_download_index') }}">{{ 'ui.source.add_download'|trans }}</a>
        {% if pagination is not empty %}
            {{ include('ui/source/_delete_all_form.html.twig') }}
        {% endif %}
    </div>
    <div class="text-center mt-4" id="queue-stats" data-stats-url="{{ path('ui_source_queue_stats') }}">
        <span class="fw-bold">{{ 'ui.source.in_queue'|trans }} <span data-counter="queued">{{ stats.queued }}</span></span> |
        <span class="fw-bold">{{ 'ui.source.in_progress'|trans }} <span data-counter="processing">{{ stats.processing }}</span></span> |
        <span class="fw-bold">{{ 'ui.source.errors'|trans }} <span data-counter="error">{{ stats.error }}</span></span>
    </div>
    {% if pagination is not empty %}
        <div class="col-sm-3 col-md-2 col-lg-1">
            <form method="get" action="{{ path('ui_source_index') }}">
                <label for="sort_by_select" class="visually-hidden">{{ 'ui.source.sort'|trans }}</label>
                <select id="sort_by_select" name="order" class="form-select form-select-sm" onchange="this.form.requestSubmit()">
                    <option value="asc" {{ order == 'asc' ? 'selected' : '' }}>{{ 'ui.source.date_asc'|trans }}</option>
                    <option value="desc" {{ order == 'desc' ? 'selected' : '' }}>{{ 'ui.source.date_desc'|trans }}</option>
                </select>
            </form>
        </div>
    {% endif %}
    <div class="table-responsive-lg">
        <table class="table table-sm">
            <thead class="text-center">
            <tr>
                <th>{{ 'ui.source.no'|trans }}</th>
                <th>{{ 'ui.source.filename'|trans }}</th>
                <th>{{ 'ui.source.size'|trans }}</th>
                <th>{{ 'ui.source.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for source in pagination %}
                <tr>
                    <td>{{ startingNumber + loop.index0 }}</td>
                    <td>{{ source.filename }}</td>
                    <td class="text-center">{{ source.size|readable_filesize(2) }}</td>
                    <td class="d-grid gap-2 text-center">
                        <div>
                            <a class="btn btn-outline-success" href="{{ path('ui_source_download', {'id': source.id}) }}" data-turbo="false">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m4-5l5 5 5-5m-5 5V3"/>
                                </svg>
                            </a>
                        </div>
                        <div>
                            <a class="btn btn-outline-secondary" href="{{ path('ui_source_show', {'id': source.id}) }}">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </a>
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <div>
                                <a class="btn btn-outline-warning" href="{{ path('ui_source_edit', {'id': source.id}) }}">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                            </div>
                        {% endif %}
                        {{ include('ui/source/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td class="text-center" colspan="4">{{ 'ui.source.no_records'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div>
        {{ knp_pagination_render(pagination) }}
    </div>
    {% include 'ui/source/_queue_stats_script.html.twig' %}
{% endblock %}
