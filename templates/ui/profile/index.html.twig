{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.profile.title'|trans }}{% endblock %}

{% block body %}
    {% set webIntakeEnabled = web_intake_enabled() %}
    <header class="mb-4">
        <h1 class="page-title">{{ 'ui.profile.heading'|trans }}</h1>
        <p class="page-subtitle">{{ app.user.email }}</p>
    </header>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="app-card profile-card">
                <span class="profile-avatar">{{ app.user.email|first|upper }}</span>
                <div class="min-w-0">
                    <div class="fw-bold text-break">{{ app.user.email }}</div>
                </div>
            </div>

            <div class="app-card mt-3 p-2">
                <a class="app-nav-link w-100" href="{{ path('ui_profile_theme') }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    {{ 'ui.profile.theme'|trans }}
                </a>
                <a class="app-nav-link w-100" href="{{ path(webIntakeEnabled ? 'ui_download_index' : 'ui_source_index') }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    {{ (webIntakeEnabled ? 'ui.profile.back_to_downloads' : 'ui.profile.back_to_library')|trans }}
                </a>
            </div>

            <div class="app-card mt-3 p-3">
                <div class="fw-semibold mb-2">{{ 'telegram.profile.title'|trans }}</div>
                {% if app.user.telegramUserId %}
                    <div class="text-muted-soft small mb-3">
                        {{ 'telegram.profile.linked'|trans({'%account%': app.user.telegramUsername ? '@' ~ app.user.telegramUsername : app.user.telegramUserId}) }}
                    </div>
                    <form method="post" action="{{ path('telegram_unlink') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('telegram_unlink') }}">
                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'telegram.profile.unlink'|trans }}</button>
                    </form>
                {% else %}
                    <div class="text-muted-soft small">{{ 'telegram.profile.not_linked'|trans }}</div>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-8">
            <div class="app-card p-4 p-lg-5">
                <h4 class="mb-4">{{ 'ui.profile.change_password'|trans }}</h4>

                {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-12">{{ form_row(form.currentPassword) }}</div>
                    <div class="col-md-6">{{ form_row(form.newPassword.first) }}</div>
                    <div class="col-md-6">{{ form_row(form.newPassword.second) }}</div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-gradient">{{ 'ui.profile.change'|trans }}</button>
                    <a class="btn btn-outline-secondary" href="{{ path(webIntakeEnabled ? 'ui_download_index' : 'ui_source_index') }}">{{ 'ui.profile.cancel'|trans }}</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
