{% extends 'base.html.twig' %}

{% block title %}{{ 'ui.download.title'|trans }}{% endblock %}

{% block body %}
    <section class="hero mb-4">
        <span class="badge rounded-pill text-bg-light text-dark mb-3">{{ 'ui.download.hero_badge'|trans }}</span>
        <h1 class="hero-title">{{ 'ui.download.hero_title'|trans }}</h1>
        <h3 class="hero-subtitle">{{ 'ui.download.paste_link'|trans }}</h3>
    </section>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="app-card p-4 p-lg-5 h-100">
                {{ form(form) }}
            </div>
        </div>
        <div class="col-lg-5">
            <div class="app-card p-4 h-100">
                <h2 class="section-title mt-0">{{ 'ui.download.disk_space'|trans }}</h2>
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <span class="text-muted-soft">{{ 'ui.download.used'|trans }}</span>
                    <strong>{{ diskSpace.used }} <span class="text-muted-soft fw-normal">/ {{ diskSpace.total }}</span></strong>
                </div>
                <div class="progress mb-3" role="progressbar" aria-label="{{ 'ui.download.used'|trans }}" aria-valuenow="{{ diskSpace.usedPercentage }}" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: {{ diskSpace.usedPercentage }}%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted-soft">
                    <span>{{ 'ui.download.free'|trans }} {{ diskSpace.free }}</span>
                    <span>{{ diskSpace.freePercentage }}%</span>
                </div>
            </div>
        </div>
    </div>

    <h2 class="section-title">{{ 'ui.download.statistics'|trans }}</h2>
    <div class="stat-grid" id="queue-stats" data-stats-url="{{ path('ui_source_queue_stats') }}">
        <div class="stat-card">
            <span class="stat-icon is-warning">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <span>
                <span class="stat-value" data-counter="queued">{{ totalPendingDownloads }}</span>
                <span class="stat-label">{{ 'ui.download.in_queue'|trans }}</span>
            </span>
        </div>
        <div class="stat-card">
            <span class="stat-icon is-info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
            </span>
            <span>
                <span class="stat-value" data-counter="processing">{{ totalInProgressDownloads }}</span>
                <span class="stat-label">{{ 'ui.download.in_progress'|trans }}</span>
            </span>
        </div>
        <div class="stat-card">
            <span class="stat-icon is-success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
            </span>
            <span>
                <span class="stat-value" data-counter="success">{{ totalSuccessDownloads }}</span>
                <span class="stat-label">{{ 'ui.download.completed'|trans }}</span>
            </span>
        </div>
        <div class="stat-card">
            <span class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
            </span>
            <span>
                <span class="stat-value" data-counter="totalSize">{{ totalDownloaded }}</span>
                <span class="stat-label">{{ 'ui.download.total_downloaded'|trans }}</span>
            </span>
        </div>
    </div>

    {% include 'ui/source/_queue_stats_script.html.twig' %}
{% endblock %}
