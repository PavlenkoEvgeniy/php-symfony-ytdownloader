<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        // Theme switcher: auto/dark/light persisted in localStorage, applied
        // before the stylesheets load to avoid a flash of the light theme.
        (function () {
            const storageKey = 'ytdownloader-theme';
            const modes = ['auto', 'dark', 'light'];

            function readMode() {
                try {
                    const stored = localStorage.getItem(storageKey);
                    return modes.includes(stored) ? stored : 'auto';
                } catch (e) {
                    return 'auto';
                }
            }

            function apply(mode) {
                const dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.dataset.bsTheme = dark ? 'dark' : 'light';
                document.documentElement.dataset.themeMode = mode;
            }

            apply(readMode());

            // Follow live system theme changes while in "auto" mode.
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
                if (readMode() === 'auto') {
                    apply('auto');
                }
            });

            document.addEventListener('DOMContentLoaded', function () {
                // Reflect the current mode in the radio group of the theme page.
                document.querySelectorAll('[data-theme-option]').forEach(function (input) {
                    input.checked = input.dataset.themeOption === readMode();
                });

                // Apply only on save, like any other profile setting.
                const saveButton = document.getElementById('theme-save');
                if (!saveButton) {
                    return;
                }
                saveButton.addEventListener('click', function () {
                    const checked = document.querySelector('[name="theme"]:checked');
                    const next = checked ? checked.value : readMode();
                    try {
                        localStorage.setItem(storageKey, next);
                    } catch (e) {
                        // Storage unavailable - still switch the theme for this page view.
                    }
                    apply(next);
                });
            });
        })();
    </script>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <title>{% block title %}{% endblock %}</title>
</head>
<body class="app-body">
{% if app.user %}
    {% set webIntakeEnabled = web_intake_enabled() %}
    <nav class="app-navbar">
        <div class="container app-navbar-inner py-2">
            <a class="app-brand" href="{{ path(webIntakeEnabled ? 'ui_download_index' : 'ui_source_index') }}">
                <span class="app-brand-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12m0 0 4-4m-4 4-4-4"/>
                        <path d="M5 21h14"/>
                    </svg>
                </span>
                <span>YtDownloader</span>
            </a>

            <div class="app-nav-links align-items-center">
                {% if webIntakeEnabled %}
                    <a class="app-nav-link {{ app.request.attributes.get('_route') == 'ui_download_index' ? 'is-active' }}" href="{{ path('ui_download_index') }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
                        {{ 'ui.nav.downloads'|trans }}
                    </a>
                {% endif %}
                <a class="app-nav-link {{ app.request.attributes.get('_route') starts with 'ui_source' ? 'is-active' }}" href="{{ path('ui_source_index') }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6c0-1.1 3.6-2 8-2s8 .9 8 2-3.6 2-8 2-8-.9-8-2Z"/><path d="M4 6v12c0 1.1 3.6 2 8 2s8-.9 8-2V6"/><path d="M4 12c0 1.1 3.6 2 8 2s8-.9 8-2"/></svg>
                    {{ 'ui.nav.library'|trans }}
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="app-nav-link" href="{{ path('admin') }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 4 7v5c0 4.4 3.4 8.4 8 9 4.6-.6 8-4.6 8-9V7l-8-4Z"/></svg>
                        {{ 'ui.nav.admin'|trans }}
                    </a>
                {% endif %}
            </div>

            <div class="app-navbar-user align-items-center">
                <a class="app-user" href="{{ path('ui_profile_index') }}" title="{{ 'ui.nav.profile'|trans }}">
                    <span class="app-avatar">{{ app.user.email|first|upper }}</span>
                    <span class="d-none d-md-inline">{{ app.user.email }}</span>
                </a>
                <a class="btn btn-ghost btn-sm" href="{{ path('ui_profile_theme') }}" title="{{ 'ui.profile.theme'|trans }}">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    <span class="visually-hidden">{{ 'ui.profile.theme'|trans }}</span>
                </a>
                <a class="btn btn-ghost btn-sm" href="{{ path('security_logout') }}" title="{{ 'ui.nav.logout'|trans }}" onclick="return confirm({{ 'ui.download.logout_confirm'|trans|json_encode }})">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
                    <span class="visually-hidden">{{ 'ui.nav.logout'|trans }}</span>
                </a>
            </div>
        </div>
    </nav>
{% endif %}

<main class="container app-main py-4 py-lg-5">
    <div class="flash-stack">
        {% for type in ['success', 'error', 'warning'] %}
            {% set alertClass = type == 'error' ? 'danger' : type %}
            {% for message in app.flashes(type) %}
                <div class="alert alert-{{ alertClass }} app-alert mb-0" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
    </div>

    {% block body %}{% endblock %}
</main>

<footer class="app-footer container d-flex flex-wrap justify-content-between gap-2">
    <span>YtDownloader · v{{ app_version }}</span>
    <span>{{ 'ui.footer.tagline'|trans }}</span>
</footer>

{% block javascript %}{% endblock %}
</body>
</html>
