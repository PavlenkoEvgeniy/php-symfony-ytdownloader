{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login.title'|trans }}{% endblock %}

{% block body %}
	<div class="container min-vh-100 d-flex flex-column align-items-center mt-2 col-md-6 offset-md-3">
		<div class="row">
            <div class="mt-3">
                <svg width="200" height="100" viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="200" height="100" rx="15" fill="url(#gradient)"/>

                    <path d="M45 35L70 50L45 65V35Z" fill="white"/>
                    <rect x="25" y="35" width="12" height="30" rx="3" fill="white"/>

                    <text x="80" y="58" font-family="Arial, sans-serif" font-size="22" fill="white" font-weight="bold">{{ 'security.login.logo_text'|trans }}</text>

                    <defs>
                        <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#667eea"/>
                            <stop offset="100%" stop-color="#764ba2"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
		</div><br>
		<div class="row w-100 justify-content-center">
			<form method="post" class="sm-col-6 sm-mx-auto h-100">
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				{% if app.user %}
					<div class="mb-3">
						{{ 'security.login.logged_in_as'|trans }}
						{{ app.user.userIdentifier }},
						<a href="{{ path('security_logout') }}">{{ 'security.login.logout'|trans }}</a>
					</div>
				{% endif %}

				<h1 class="h3 mb-3 font-weight-normal text-center">{{ 'security.login.sign_in_heading'|trans }}</h1>
				<label for="inputEmail">{{ 'security.login.email'|trans }}</label>
				<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control mb-2" autocomplete="email" required autofocus>
				<label for="inputPassword">{{ 'security.login.password'|trans }}</label>
				<input type="password" name="password" id="inputPassword" class="form-control mb-4" autocomplete="current-password" required>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<div class="checkbox mb-3">
					<label>
						<input type="checkbox" name="_remember_me">
						{{ 'security.login.remember_me'|trans }}
					</label>
				</div>

				<button class="btn btn-primary" type="submit">
					{{ 'security.login.sign_in'|trans }}
				</button>
			</form>
		</div>
		<div class="mt-auto">v{{ app_version }}</div>
	</div>
{% endblock %}
