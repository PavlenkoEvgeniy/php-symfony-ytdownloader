{% extends 'base.html.twig' %}

{% block title %}{{ 'security.login.title'|trans }}{% endblock %}

{% block body %}
    <div class="auth-shell">
        <div class="app-card auth-card">
            <span class="auth-brand">YtDownloader</span>

            <h1 class="h3 fw-bold mb-1">{{ 'security.login.sign_in_heading'|trans }}</h1>
            <p class="text-muted-soft mb-4">{{ 'security.login.subtitle'|trans }}</p>

            {% if error %}
                <div class="alert alert-danger app-alert mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert-info app-alert mb-3">
                    {{ 'security.login.logged_in_as'|trans }}
                    {{ app.user.userIdentifier }},
                    <a href="{{ path('security_logout') }}">{{ 'security.login.logout'|trans }}</a>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">{{ 'security.login.email'|trans }}</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="inputPassword" class="form-label">{{ 'security.login.password'|trans }}</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">{{ 'security.login.remember_me'|trans }}</label>
                </div>

                <button class="btn btn-gradient w-100" type="submit">
                    {{ 'security.login.sign_in'|trans }}
                </button>
            </form>

        </div>
    </div>
{% endblock %}
