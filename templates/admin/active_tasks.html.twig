{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title 'Active Tasks' %}

{% block main %}
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="badge bg-secondary">Queued: {{ stats.queued }}</span>
        <span class="badge bg-primary">Processing: {{ stats.processing }}</span>
        <span class="badge bg-success">Success: {{ stats.success }}</span>
        <span class="badge bg-danger">Errors: {{ stats.error }}</span>

        {% if stats.queued > 0 %}
            <form method="post" action="{{ ea_url().setRoute('admin_purge_queue') }}"
                  onsubmit="return confirm('Purge {{ stats.queued }} queued task(s) and all pending messages? This is irreversible.')">
                <input type="hidden" name="_token" value="{{ csrf_token('purge_queue') }}">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete all queued tasks and pending messages">
                    <i class="fa-solid fa-broom"></i> Purge Queue
                </button>
            </form>
        {% endif %}

        {% if stats.queued > 0 or stats.processing > 0 %}
            <form method="post" action="{{ ea_url().setRoute('admin_reset_stuck_tasks') }}"
                  onsubmit="return confirm('Reset processing task(s) to queued and redeliver stuck messages? Make sure no download is currently running.')">
                <input type="hidden" name="_token" value="{{ csrf_token('reset_stuck_tasks') }}">
                <button type="submit" class="btn btn-sm btn-outline-warning" title="Reset processing tasks and redeliver stuck messages">
                    <i class="fa-solid fa-rotate-left"></i> Reset Stuck
                </button>
            </form>
        {% endif %}
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Id</th>
                <th>Url</th>
                <th class="text-center">Quality</th>
                <th class="text-center">Status</th>
                <th class="text-center">Created</th>
            </tr>
            </thead>
            <tbody>
            {% for task in tasks %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td class="text-break">
                        <a href="{{ task.url }}" target="_blank" rel="noopener noreferrer">{{ task.url }}</a>
                    </td>
                    <td class="text-center">{{ task.quality }}</td>
                    <td class="text-center">
                        <span class="badge bg-{{ task.status == 'queued' ? 'secondary' : (task.status == 'processing' ? 'primary' : 'danger') }}">{{ task.status }}</span>
                    </td>
                    <td class="text-center">{{ task.createdAt ? task.createdAt|date('Y-m-d H:i') : '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td class="text-center" colspan="5">No active tasks...</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}