{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.active_tasks.title'|trans }}{% endblock %}

{% block main %}
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="badge bg-secondary">{{ 'admin.active_tasks.queued'|trans }} {{ stats.queued }}</span>
        <span class="badge bg-primary">{{ 'admin.active_tasks.processing'|trans }} {{ stats.processing }}</span>
        <span class="badge bg-success">{{ 'admin.active_tasks.success'|trans }} {{ stats.success }}</span>
        <span class="badge bg-danger">{{ 'admin.active_tasks.errors'|trans }} {{ stats.error }}</span>

        {% if stats.queued > 0 %}
            <form method="post" action="{{ ea_url().setRoute('admin_purge_queue') }}"
                  onsubmit="return confirm({{ 'admin.active_tasks.purge_confirm'|trans({'%count%': stats.queued})|json_encode }})">
                <input type="hidden" name="_token" value="{{ csrf_token('purge_queue') }}">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'admin.active_tasks.purge_title'|trans }}">
                    <i class="fa-solid fa-broom"></i> {{ 'admin.active_tasks.purge'|trans }}
                </button>
            </form>
        {% endif %}

        {% if stats.queued > 0 or stats.processing > 0 %}
            <form method="post" action="{{ ea_url().setRoute('admin_reset_stuck_tasks') }}"
                  onsubmit="return confirm({{ 'admin.active_tasks.reset_confirm'|trans|json_encode }})">
                <input type="hidden" name="_token" value="{{ csrf_token('reset_stuck_tasks') }}">
                <button type="submit" class="btn btn-sm btn-outline-warning" title="{{ 'admin.active_tasks.reset_title'|trans }}">
                    <i class="fa-solid fa-rotate-left"></i> {{ 'admin.active_tasks.reset'|trans }}
                </button>
            </form>
        {% endif %}
    </div>

    {% if orphans is not empty %}
        <div class="card mt-3">
            <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <span><i class="fa-solid fa-trash-can"></i> {{ 'admin.active_tasks.orphan_files'|trans({'%count%': orphans|length}) }}</span>
                <form method="post" action="{{ ea_url().setRoute('admin_prune_orphans') }}"
                      onsubmit="return confirm({{ 'admin.active_tasks.prune_confirm'|trans({'%count%': orphans|length})|json_encode }})">
                    <input type="hidden" name="_token" value="{{ csrf_token('prune_orphans') }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                            title="{{ 'admin.active_tasks.prune_title'|trans }}">
                        <i class="fa-solid fa-broom"></i> {{ 'admin.active_tasks.prune'|trans }}
                    </button>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                        <tr>
                            <th>{{ 'admin.active_tasks.file'|trans }}</th>
                            <th class="text-center">{{ 'admin.active_tasks.size'|trans }}</th>
                            <th class="text-center">{{ 'admin.active_tasks.modified'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for orphan in orphans %}
                            <tr>
                                <td class="text-break">{{ orphan.name }}</td>
                                <td class="text-center">{{ orphan.size|readable_filesize(2) }}</td>
                                <td class="text-center">{{ orphan.modifiedAt|date('Y-m-d H:i') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ 'admin.active_tasks.id'|trans }}</th>
                <th>{{ 'admin.active_tasks.url'|trans }}</th>
                <th class="text-center">{{ 'admin.active_tasks.quality'|trans }}</th>
                <th class="text-center">{{ 'admin.active_tasks.status'|trans }}</th>
                <th class="text-center">{{ 'admin.active_tasks.attempts'|trans }}</th>
                <th class="text-center">{{ 'admin.active_tasks.created'|trans }}</th>
                <th class="text-center">{{ 'admin.active_tasks.error'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for task in tasks %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td class="text-break">
                        <a href="{{ task.url }}" target="_blank" rel="noopener noreferrer">{{ task.url }}</a>
                    </td>
                    <td class="text-center">{{ ('form.quality.' ~ task.quality)|trans }}</td>
                    <td class="text-center">
                        <span class="badge bg-{{ task.status == 'queued' ? 'secondary' : (task.status == 'processing' ? 'primary' : 'danger') }}">{{ ('admin.status.' ~ task.status)|trans }}</span>
                    </td>
                    <td class="text-center">{{ task.attempts }}</td>
                    <td class="text-center">{{ task.createdAt ? task.createdAt|date('Y-m-d H:i') : '' }}</td>
                    <td class="text-break">{{ task.errorMessage ?: '' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td class="text-center" colspan="7">{{ 'admin.active_tasks.no_active'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}