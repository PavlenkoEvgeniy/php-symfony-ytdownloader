{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block main %}
    <style>
        .settings-intake .form-check { padding-left: 0; }
        .settings-intake .form-check-input { margin-left: 0; margin-right: .5rem; }
    </style>

    {% set web_intake_confirm = 'admin.settings.web_intake_confirm'|trans %}

    {{ form_start(form) }}
        <div class="card mb-3">
            <div class="card-header">
                <i class="fa-solid fa-globe"></i> {{ 'admin.settings.web_intake_section'|trans }}
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">{{ 'admin.settings.web_intake_hint'|trans }}</p>

                <div class="settings-intake">
                    {{ form_widget(form.webIntakeEnabled, {'attr': {
                        'role': 'switch',
                        'onclick': 'return confirm(' ~ (web_intake_confirm|json_encode) ~ ')',
                    }}) }}
                    {{ form_errors(form.webIntakeEnabled) }}
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <i class="fa-solid fa-paper-plane"></i> {{ 'admin.settings.telegram_progress_section'|trans }}
            </div>
            <div class="card-body">
                <div class="alert alert-info py-2 mb-3" role="status">
                    <span class="fw-semibold">{{ 'admin.settings.progress_current'|trans }}:</span>
                    {% if settings.progressIntervalMinutes > 0 %}
                        {{ 'admin.settings.progress_every'|trans({'%minutes%': settings.progressIntervalMinutes}) }}
                    {% else %}
                        {{ 'admin.settings.progress_disabled'|trans }}
                    {% endif %}
                </div>

                {{ form_row(form.progressIntervalMinutes) }}
            </div>
        </div>

        {{ form_row(form.save) }}
    {{ form_end(form) }}
{% endblock %}
