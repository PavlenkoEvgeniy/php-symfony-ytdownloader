{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.settings.title'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            <p class="text-muted">{{ 'admin.settings.web_intake_hint'|trans }}</p>

            {{ form_start(form) }}
                {{ form_row(form.webIntakeEnabled) }}
                {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
